{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeskReminder",
  "version": "1.1.2",
  "identifier": "com.deskreminder.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "桌面提醒",
        "width": 1040,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost ws://localhost:5173 http://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "喝水与起立提醒",
    "longDescription": "在电脑解锁运行时按自定义规则提醒喝水、起立活动，支持自定义提醒类型。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
